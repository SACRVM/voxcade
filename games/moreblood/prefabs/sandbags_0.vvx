format = "voxcade voxel 1"
size = [13, 5, 6]

# The colours are the world's numbers in this order (the first is 1);
# a marker places a thing of that kind instead of a voxel.
[palette]
a = "#847654"
b = "#baaa80"
c = "#b0a076"
d = "#a4946a"

[[frame]]
layers = """
accccaabbbba
accccaabbbba
abbbbaacccca
abbbbaacccca

accccaabbbba
accccaabbbba
abbbbaacccca
abbbbaacccca

ddaaddddaadd
ddaaddddaadd
ccaabbbbaadd
ccaabbbbaadd

ddaaddddaadd
ddaaddddaadd
ccaabbbbaadd
ccaabbbbaadd

addddaabbbba
addddaabbbba
abbbbaadddda
abbbbaadddda

.dddd..bbbb.
.dddd..bbbb.
.bbbb..dddd.
.bbbb..dddd.
"""
