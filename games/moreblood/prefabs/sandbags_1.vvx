format = "voxcade voxel 1"
size = [13, 5, 6]

# The colours are the world's numbers in this order (the first is 1);
# a marker places a thing of that kind instead of a voxel.
[palette]
a = "#847654"
b = "#a4946a"
c = "#b0a076"
d = "#baaa80"

[[frame]]
layers = """
abbbbaabbbba *4

abbbbaabbbba *4

bbaaccccaabb
bbaaccccaabb
ccaabbbbaacc
ccaabbbbaacc

bbaaccccaabb
bbaaccccaabb
ccaabbbbaacc
ccaabbbbaacc

accccaacccca
accccaacccca
accccaadddda
accccaadddda

.cccc..cccc.
.cccc..cccc.
.cccc..dddd.
.cccc..dddd.
"""
