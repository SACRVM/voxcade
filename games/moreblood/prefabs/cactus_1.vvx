format = "voxcade voxel 1"
size = [11, 5, 25]

# The colours are the world's numbers in this order (the first is 1);
# a marker places a thing of that kind instead of a voxel.
[palette]
a = "#588c52"
b = "#467644"
c = "#dcd6aa"
d = "#689c5e"
e = "#ec7896"

[[frame]]
at = [-2, -2, 0]
layers = """
.ba.....
baba....
abab....
.ab.....
*3

.ba.....
baba....
abab....
.cb.....

.ba.....
baba....
abab....
.ab.....
*4

.ba.....
babcbbab
ababbbba
.ab.....

.ba.....
bababbab
ababbbba
.ab.....

.ba.....
baba..ab
abab..ba
.ab.....

.ba.....
baba..cb
abab..ba
.ab.....

.ba.....
baba..ab
abac..ba
.ab.....

.ba.....
baba..ab
abab..ba
.ab.....

.ba.....
caba..ab
abab..bc
.ab.....

.ba.....
bcba..dd
abac..dd
.ac.....

.ba.....
baba....
abab....
.ab.....
*3

.ba.....
bcba....
abab....
.ab.....

.ba.....
baba....
acac....
.ab.....

.ba.....
baba....
abab....
.ab.....

.ba.....
baba....
abab....
.ab.....

........
.dd.....
.dd.....
........

........
..e.....
........
........
"""
