format = "voxcade voxel 1"
size = [29, 29, 15]

# The colours are the world's numbers in this order (the first is 1);
# a marker places a thing of that kind instead of a voxel.
[palette]
a = "#7c7268"
b = "#686058"
c = "#3e3a36"
d = "#58524c"

[[frame]]
at = [-8, -6, 4]
layers = """
............... *4
.......aa......
............... *6

...............
.....aaa.dccd..
....aaaaadcccd.
....aaaaaddccc.
....bbbaaaddd..
....bbbbaadd...
....bbbbaadc...
............... *4

....aaaaad.....
...daaaaacdddd.
..ddaaaaacddddd
..daaaaaadddddd
.aaabbbaaadccdd
.abbbbbbaaddcd.
.bbbbbbbaadddd.
.bbbbbbbaadd...
.bbbbbbbaad....
...bbbba.......
...............

......aaad.....
.....aaaacdddd.
....aaaaacddddd
...aaaaaaaddddd
..aabbbaaaacddd
..abbbbbaaaacdd
.bbbbbbbaaaaad.
bbbbbbbbaaaaa..
bbbbbbbbaaaa...
.aabbbbaa......
..caa..........

.......aa......
.......aacada..
......baacaaaaa
.....bbaaaaaaaa
....bbbaaaacccc
...abbbaaaaaac.
...abbbbbaaaac.
..aabbbbbbbaa..
.aaaaaaaaaa....
aaaaaa..a......
...............

...............
........acaa...
........acaaaa.
.......bacaaaa.
......bbbaccaa.
.....aaabbbbb..
....acaabbbbb..
....a.aabbbb...
...aa...b......
...............
...............

............... *3
..........a....
........bbcc...
.......abb.....
............... *5
"""
