format = "voxcade voxel 1"
size = [27, 27, 15]

# The colours are the world's numbers in this order (the first is 1);
# a marker places a thing of that kind instead of a voxel.
[palette]
a = "#423830"
b = "#605246"
c = "#8e7a64"
d = "#746454"

[[frame]]
at = [-4, -5, 5]
layers = """
.........
.........
.dddddd..
.aaaaad..
.cccdddd.
.bbbccdd.
..bbbcd..
..babad..
..bbac...
...aa....
.........

..d.d....
.dddddd..
dddddddd.
dddddddd.
ccacdddd.
.aabccdd.
.aaaaaaa.
.abbbcdd.
.abbbccd.
..abccc..
...cca...

.dddaa...
ddddddd..
dddddddd.
dddddddd.
ccaccdaa.
baabccaad
.aaabaaa.
.abbbccd.
.abbbcc..
.babbc...
...cc....

..da.....
.dddaa...
.dddddaa.
.ddddd...
ccaacaa..
baabcaa..
aaabbba..
.abbbbc..
.abbbb...
...bb....
.........

.........
.........
..dddd...
.ddddda..
.caaaaa..
.aaacaa..
.aabbbb..
..abba...
...bb....
.........
.........

......... *4
....ac...
....aa...
......... *5
"""
