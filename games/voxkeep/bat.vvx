format = "voxcade voxel 1"
size = [13, 3, 11]

[palette]
a = "#9664ac"
b = "#ff5046"
c = "#70488a"
d = "#56346c"

[[frame]]
at = [-6, -1, 3]
layers = """
.....aaa..... *3

.....aaa..... *3

.....bab.....
....caaac....
.....aaa.....

.....aaa.....
..cccaaaccc..
.....aaa.....

.............
dccc.a.a.cccd
.............

.............
dcc.......ccd
.............

.............
dc.........cd
.............

.............
d...........d
.............
"""

[[frame]]
at = [-6, -1, 2]
layers = """
.............
dc.........cd
.............

.....aaa.....
.ccc.aaa.ccc.
.....aaa.....

.....aaa.....
...ccaaacc...
.....aaa.....

.....bab.....
.....aaa.....
.....aaa.....

.....aaa..... *3

.............
.....a.a.....
.............
"""
