@arp1   square duty=0.5 arp=0,4,7 attack=0.01 decay=0.4 sustain=0.45 release=0.3 lowpass=2000 arp_speed=50 volume=0.14
@arp2   square duty=0.5 arp=0,3,7 attack=0.01 decay=0.4 sustain=0.45 release=0.3 lowpass=2000 arp_speed=50 volume=0.14

